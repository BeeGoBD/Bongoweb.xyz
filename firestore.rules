rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Support Chat threads
    match /supportChats/{phone} {
      allow read, write: if true;
    }

    // Catalog websites
    match /customWebsites/{code} {
      allow read, write: if true;
    }

    // Delivered Credentials
    match /deliveredCredentials/{id} {
      allow read, write: if true;
    }

    // Password Reset Requests
    match /resetRequests/{id} {
      allow read, write: if true;
    }

    // Site Settings (including Logo and Branding configuration)
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }
  }
}
